# Copie para .env e preencha. O .env é ignorado pelo git.

# Provedor do agent revisor: "gemini" ou "anthropic".
LLM_PROVIDER=gemini

# Necessária quando LLM_PROVIDER=gemini (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Necessária quando LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Base vetorial: "http" usa o serviço do docker-compose; "local" usa disco.
CHROMA_MODE=http
CHROMA_PATH=.chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000

EMBEDDING_MODEL=all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.35

DATABASE_URL=postgresql+psycopg://rotulai:rotulai@localhost:5432/rotulai
